import curses
import random
import time

SHAPES = {
    'I': ([[1, 1, 1, 1]], 1),                  
    'O': ([[1, 1], [1, 1]], 2),                
    'T': ([[0, 1, 0], [1, 1, 1]], 3),          
    'L': ([[0, 0, 1], [1, 1, 1]], 4),          
    'J': ([[1, 0, 0], [1, 1, 1]], 5),          
    'S': ([[0, 1, 1], [1, 1, 0]], 6),          
    'Z': ([[1, 1, 0], [0, 1, 1]], 7)           
}

class Tetris:
    def __init__(self, width=10, height=20):
        self.width = width
        self.height = height
        self.board = [[0] * width for _ in range(height)]
        self.score = 0
        self.lines = 0
        self.level = 1
        
        self.bag = []
        self.next_piece = self.get_random_piece()
        self.current_piece = self.get_random_piece()
        self.hold_piece = None
        self.can_hold = True
        
        self.x = self.width // 2 - len(self.current_piece["matrix"][0]) // 2
        self.y = 0
        self.game_over = False

    def get_random_piece(self):
        if not self.bag:
            self.bag = list(SHAPES.keys())
            random.shuffle(self.bag)
        shape_name = self.bag.pop()
        shape_matrix, color = SHAPES[shape_name]
        return {"matrix": shape_matrix, "color": color, "name": shape_name}

    def rotate(self, matrix):
        return [[matrix[y][x] for y in range(len(matrix))] for x in range(len(matrix[0]) - 1, -1, -1)]

    def check_collision(self, matrix, offset_x, offset_y):
        for cy, row in enumerate(matrix):
            for cx, cell in enumerate(row):
                if cell:
                    if (offset_y + cy >= self.height or 
                        offset_x + cx < 0 or 
                        offset_x + cx >= self.width or 
                        (offset_y + cy >= 0 and self.board[offset_y + cy][offset_x + cx])):
                        return True
        return False

    def lock_piece(self):
        for cy, row in enumerate(self.current_piece["matrix"]):
            for cx, val in enumerate(row):
                if val and self.y + cy >= 0:
                    self.board[self.y + cy][self.x + cx] = self.current_piece["color"]
        
        self.clear_lines()
        self.current_piece = self.next_piece
        self.next_piece = self.get_random_piece()
        self.x = self.width // 2 - len(self.current_piece["matrix"][0]) // 2
        self.y = 0
        self.can_hold = True

        if self.check_collision(self.current_piece["matrix"], self.x, self.y):
            self.game_over = True

    def clear_lines(self):
        new_board = [row for row in self.board if any(cell == 0 for cell in row)]
        lines_cleared = self.height - len(new_board)
        if lines_cleared > 0:
            for _ in range(lines_cleared):
                new_board.insert(0, [0] * self.width)
            self.board = new_board
            self.lines += lines_cleared
            self.level = (self.lines // 10) + 1
            
            multipliers = {1: 100, 2: 300, 3: 500, 4: 800}
            self.score += multipliers.get(lines_cleared, 0) * self.level

    def hold(self):
        if not self.can_hold:
            return
        if self.hold_piece is None:
            self.hold_piece = self.current_piece
            self.current_piece = self.next_piece
            self.next_piece = self.get_random_piece()
        else:
            self.hold_piece, self.current_piece = self.current_piece, self.hold_piece
        
        self.x = self.width // 2 - len(self.current_piece["matrix"][0]) // 2
        self.y = 0
        self.can_hold = False

    def hard_drop(self):
        while not self.check_collision(self.current_piece["matrix"], self.x, self.y + 1):
            self.y += 1
            self.score += 2 
        self.lock_piece()

    def get_ghost_y(self):
        ghost_y = self.y
        while not self.check_collision(self.current_piece["matrix"], self.x, ghost_y + 1):
            ghost_y += 1
        return ghost_y

def draw_matrix(stdscr, matrix, offset_x, offset_y, color, is_ghost=False):
    for cy, row in enumerate(matrix):
        for cx, cell in enumerate(row):
            if cell:
                try:
                    if is_ghost:
                        stdscr.addstr(offset_y + cy, (offset_x + cx) * 2 + 1, "[]", curses.color_pair(color + 10))
                    else:
                        stdscr.addstr(offset_y + cy, (offset_x + cx) * 2 + 1, "  ", curses.color_pair(color))
                except curses.error:
                    pass

def main(stdscr):
    # Safely attempt to hide the terminal cursor
    try:
        curses.curs_set(0)
    except curses.error:
        pass
        
    stdscr.nodelay(True)
    stdscr.timeout(20) 
    
    curses.start_color()
    curses.use_default_colors()
    
    curses.init_pair(1, curses.COLOR_WHITE, curses.COLOR_CYAN)
    curses.init_pair(2, curses.COLOR_WHITE, curses.COLOR_YELLOW)
    curses.init_pair(3, curses.COLOR_WHITE, curses.COLOR_MAGENTA)
    curses.init_pair(4, curses.COLOR_BLACK, curses.COLOR_WHITE)
    curses.init_pair(5, curses.COLOR_WHITE, curses.COLOR_BLUE)
    curses.init_pair(6, curses.COLOR_WHITE, curses.COLOR_GREEN)
    curses.init_pair(7, curses.COLOR_WHITE, curses.COLOR_RED)

    curses.init_pair(11, curses.COLOR_CYAN, -1)
    curses.init_pair(12, curses.COLOR_YELLOW, -1)
    curses.init_pair(13, curses.COLOR_MAGENTA, -1)
    curses.init_pair(14, curses.COLOR_WHITE, -1)
    curses.init_pair(15, curses.COLOR_BLUE, -1)
    curses.init_pair(16, curses.COLOR_GREEN, -1)
    curses.init_pair(17, curses.COLOR_RED, -1)

    game = Tetris()
    
    last_fall_time = time.time()
    needs_redraw = True # Only redraw when this is True
    
    while not game.game_over:
        fall_speed = max(0.1, 0.8 - (game.level * 0.05))
        
        # 1. Handle Input
        key = stdscr.getch()
        if key != -1: 
            needs_redraw = True # Input detected, trigger redraw
            if key == ord('q'):
                break
            elif key == curses.KEY_LEFT:
                if not game.check_collision(game.current_piece["matrix"], game.x - 1, game.y):
                    game.x -= 1
            elif key == curses.KEY_RIGHT:
                if not game.check_collision(game.current_piece["matrix"], game.x + 1, game.y):
                    game.x += 1
            elif key == curses.KEY_DOWN:
                if not game.check_collision(game.current_piece["matrix"], game.x, game.y + 1):
                    game.y += 1
                    game.score += 1
            elif key == curses.KEY_UP:
                rotated = game.rotate(game.current_piece["matrix"])
                if not game.check_collision(rotated, game.x, game.y):
                    game.current_piece["matrix"] = rotated
                elif not game.check_collision(rotated, game.x - 1, game.y):
                    game.current_piece["matrix"] = rotated
                    game.x -= 1
                elif not game.check_collision(rotated, game.x + 1, game.y):
                    game.current_piece["matrix"] = rotated
                    game.x += 1
            elif key == ord(' '): 
                game.hard_drop()
                last_fall_time = time.time() 
            elif key in [ord('c'), ord('h')]: 
                game.hold()
                last_fall_time = time.time()
                
        # 2. Gravity Logic
        current_time = time.time()
        if current_time - last_fall_time >= fall_speed:
            needs_redraw = True # Gravity triggered, trigger redraw
            last_fall_time = current_time
            if not game.check_collision(game.current_piece["matrix"], game.x, game.y + 1):
                game.y += 1
            else:
                game.lock_piece()

        # 3. Render (ONLY if a change occurred)
        if needs_redraw:
            stdscr.erase() 
            
            # Render Board Boundaries
            for y in range(game.height):
                stdscr.addstr(y, 0, "|")
                stdscr.addstr(y, game.width * 2 + 1, "|")
            stdscr.addstr(game.height, 0, "+" + "-" * (game.width * 2) + "+")
            
            # Render Locked Pieces
            for y, row in enumerate(game.board):
                for x, cell in enumerate(row):
                    if cell:
                        stdscr.addstr(y, x * 2 + 1, "  ", curses.color_pair(cell))
                    else:
                        stdscr.addstr(y, x * 2 + 1, " .", curses.A_DIM)

            # Render Ghost Piece
            ghost_y = game.get_ghost_y()
            draw_matrix(stdscr, game.current_piece["matrix"], game.x, ghost_y, game.current_piece["color"], is_ghost=True)

            # Render Active Piece
            draw_matrix(stdscr, game.current_piece["matrix"], game.x, game.y, game.current_piece["color"])

            # Render UI Panels
            ui_offset_char = game.width * 2 + 5
            ui_offset_matrix = (ui_offset_char - 1) // 2 
            
            stdscr.addstr(0, ui_offset_char, "HOLD (c/h):")
            if game.hold_piece:
                draw_matrix(stdscr, game.hold_piece["matrix"], ui_offset_matrix, 1, game.hold_piece["color"])
                
            stdscr.addstr(5, ui_offset_char, f"SCORE: {game.score}")
            stdscr.addstr(6, ui_offset_char, f"LINES: {game.lines}")
            stdscr.addstr(7, ui_offset_char, f"LEVEL: {game.level}")
            
            stdscr.addstr(9, ui_offset_char, "NEXT:")
            draw_matrix(stdscr, game.next_piece["matrix"], ui_offset_matrix, 10, game.next_piece["color"])

            stdscr.addstr(14, ui_offset_char, "CONTROLS:")
            stdscr.addstr(15, ui_offset_char, "\u2190 \u2192 : Move")
            stdscr.addstr(16, ui_offset_char, "\u2191   : Rotate")
            stdscr.addstr(17, ui_offset_char, "\u2193   : Soft Drop")
            stdscr.addstr(18, ui_offset_char, "SPC : Hard Drop")
            stdscr.addstr(19, ui_offset_char, "C/H : Hold")
            stdscr.addstr(20, ui_offset_char, "Q   : Quit")

            stdscr.refresh()
            needs_redraw = False # Reset flag until next action

    stdscr.clear()
    stdscr.addstr(game.height // 2, (game.width * 2) // 2 - 4, "GAME OVER", curses.A_BLINK | curses.color_pair(17))
    stdscr.addstr(game.height // 2 + 2, (game.width * 2) // 2 - 8, f"FINAL SCORE: {game.score}")
    stdscr.refresh()
    curses.napms(3000)

if __name__ == "__main__":
    curses.wrapper(main)